{
  "manifest_version": 3,
  "name": "Dhamma.gift Search and Word Lookup",
  "version": "0.6.1",
  "description": "Look up any Pali word on any site. Powered by Dict.Dhamma.Gift: DPD, PTS, Gandhari, Sanskrit and more.",
  "permissions": [
    "storage",
    "activeTab",
     "contextMenus",
    "scripting"
      ],
  "host_permissions": [
    "https://dict.dhamma.gift/*",
    "https://dhamma.gift/*"
  ],
"content_security_policy": {
  "extension_pages": "script-src 'self'; object-src 'none';"
},
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",    
      "32": "icon-32x32.png",
      "48": "icon-48x48.png",
      "128": "icon-128x128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "MacCtrl+Shift+X"
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon-32x32.png",
    "32": "icon-32x32.png",
    "48": "icon-48x48.png",
    "128": "icon-128x128.png"
  }
}
